    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>Goggle 3 LiveView</AssemblyName>
    <Product>Goggle 3 LiveView</Product>
    <Title>Goggle 3 LiveView</Title>
    <Version>0.3.2</Version>
    <RuntimeFrameworkVersion>10.0.13</RuntimeFrameworkVersion>
    <ApplicationIcon>../../assets/AppIcon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Goggles3.Core/Goggles3.Core.csproj" />
    <Resource Include="../../assets/AppIcon.png" Link="AppIcon.png" />
    <Content Include="../scripts/Prepare-Usb.ps1" Link="Prepare-Usb.ps1" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
